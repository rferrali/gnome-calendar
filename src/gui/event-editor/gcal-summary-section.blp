using Gtk 4.0;
using Adw 1;

template $GcalSummarySection: $GcalEventEditorSection {
  Adw.EntryRow summary_entry {
    title: _("Title");
    notify::text => $on_summary_entry_text_changed_cb(template);
    editable: bind template.dialog as <$GcalEventEditorDialog>.writable;
  }

  Adw.EntryRow location_entry {
    title: _("Location");
    notify::text => $on_location_entry_changed_cb(template);
    editable: bind template.dialog as <$GcalEventEditorDialog>.writable;

    /* Fork: puts the meeting-room-url setting in an empty Location */
    [suffix]
    Button meeting_room_button {
      icon-name: "camera-video-symbolic";
      tooltip-text: _("Add Meeting Room");
      valign: center;
      visible: false;
      clicked => $on_meeting_room_button_clicked_cb(template) not-swapped;

      styles [
        "flat",
      ]
    }
  }
}
