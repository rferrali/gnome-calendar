using Gtk 4.0;
using Adw 1;

template $GcalAttendeesSection: $GcalEventEditorSection {
  title: _("Guests");

  /* Fork: reply to the invitation */
  Adw.ActionRow response_row {
    title: _("Your Response");
    visible: false;

    [suffix]
    $GcalRsvpBox rsvp_box {
      responded => $on_rsvp_responded_cb(template) not-swapped;
    }
  }

  /* Fork: guests and their replies; editable when the user organizes the event */
  $GcalGuestList guest_list {
    add-guest => $on_add_guest_cb(template) not-swapped;
    remove-guest => $on_remove_guest_cb(template) not-swapped;
  }
}
